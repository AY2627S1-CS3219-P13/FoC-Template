# Local setup: sh user-service/scripts/init-env.sh
# This example contains no real secrets. Never commit .env.
POSTGRES_PASSWORD=REPLACE_DATABASE_PASSWORD
USER_DATABASE_URL=postgres://foc_user:REPLACE_DATABASE_PASSWORD@user-db:5432/foc_user?sslmode=disable
USER_INTERNAL_TOKEN=REPLACE_INTERNAL_TOKEN
USER_CODE_SECRET=REPLACE_CODE_SECRET

# Exact browser origin, with no trailing slash.
USER_APP_ORIGIN=http://localhost:3000
# Proposed NUS domains: confirm the team's intended student allowlist.
USER_ALLOWED_EMAIL_DOMAINS=u.nus.edu,nus.edu.sg
USER_COOKIE_SECURE=false
# Absolute expiry; logging in on another device is allowed.
USER_SESSION_TTL=24h

# Mailpit captures local email; no real email is sent.
USER_SMTP_ADDRESS=mailpit:1025
USER_SMTP_FROM=noreply@foc.local
USER_SMTP_TLS=false
USER_SMTP_USERNAME=
USER_SMTP_PASSWORD=

# Tests only: injected by the Compose test profile, never point at application data.
# USER_TEST_DATABASE_URL=postgres://test:test@user-test-db:5432/user_service_test?sslmode=disable
