FROM ghcr.io/mlflow/mlflow:v3.5.1
USER root
RUN mkdir -p /data && chown 65532:65532 /data
USER 65532:65532
ENV HOME=/tmp
WORKDIR /data
CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", "--backend-store-uri", "sqlite:////data/mlflow.db", "--artifacts-destination", "/data/artifacts", "--allowed-hosts", "mlflow:5000,localhost:5000,127.0.0.1:5000"]
