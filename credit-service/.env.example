# Local setup: sh credit-service/scripts/init-env.sh
# This example contains no real secrets. Never commit .env.
CREDIT_POSTGRES_PASSWORD=REPLACE_DATABASE_PASSWORD
# Order and User Service send this to call port 8081.
CREDIT_INTERNAL_TOKEN=REPLACE_INTERNAL_TOKEN
# Copy USER_INTERNAL_TOKEN from the root .env so Credit can validate sessions.
CREDIT_USER_INTERNAL_TOKEN=REPLACE_USER_INTERNAL_TOKEN
